@echo off
title Electricity Billing System
cd /d "%~dp0"

:: ==============================================================================
:: 1. ពិនិត្យមើលថាតើ Python Web Server កំពុងដំណើរការស្រាប់លើ Port 5000 ឬនៅ
:: ==============================================================================
netstat -ano | findstr :5000 | findstr LISTENING >nul
if %ERRORLEVEL% neq 0 (
    :: បង្កើត Database និងទិន្នន័យគំរូ ប្រសិនបើមិនទាន់មាន
    if not exist "electricity_system.db" (
        python seed_data.py
    )

    :: ដំណើរការ Python Server នៅ Background ដោយស្ងាត់ៗ (គ្មានផ្ទាំង CMD ខ្មៅ)
    start "" pythonw app.py

    :: រង់ចាំ ២ វិនាទីដើម្បីឱ្យ Server ភ្ជាប់ Port 5000 រួចរាល់
    ping 127.0.0.1 -n 3 >nul
)

:: ==============================================================================
:: 2. បើកកម្មវិធីក្នុង Web Browser ដោយស្វ័យប្រវត្តិ (Default Web Browser)
:: ==============================================================================
start http://127.0.0.1:5000

:: ==============================================================================
:: 3. បិទផ្ទាំង CMD ភ្លាមៗ (Auto Exit CMD)
:: ==============================================================================
exit
